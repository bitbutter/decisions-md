{
  "name": "decisions-md",
  "version": "3.0.0-rc.1",
  "description": "Delivers a project's binding DECISIONS.md rules to a coding agent at the moment it edits code",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bitbutter/decisions-md.git"
  },
  "engines": {
    "node": ">=22.18"
  },
  "files": [
    "bin",
    "core",
    "harnesses",
    "spec",
    "docs/ADAPTERS.md",
    "README.md",
    "LICENSE",
    "!harnesses/pi/*.test.ts"
  ],
  "bin": {
    "decisions": "./bin/decisions.ts"
  },
  "pi": {
    "extensions": [
      "./harnesses/pi/index.ts"
    ]
  },
  "keywords": [
    "pi-package",
    "decisions"
  ],
  "scripts": {
    "test": "node --test \"tests/**/*.test.ts\" \"harnesses/pi/*.test.ts\"",
    "conformance": "node tests/conformance/run.ts",
    "typecheck": "tsc --noEmit",
    "live": "node tests/live/check.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^5.9.3"
  }
}
