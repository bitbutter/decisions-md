# Plugin state lives in ~/.claude/decisions-md/, never in a project. A project's
# .decisions/config.json is the project's own file and belongs in its repo.

# Python bytecode
__pycache__/
*.py[cod]

# OS noise
.DS_Store
Thumbs.db

# Test artefacts
tests/tmp/

# Chainlink issue tracker: project-scoped but machine-local, never committed.
# `chainlink init` also drops .claude/ (hooks) and .mcp.json here.
.chainlink/
.claude/
.mcp.json
